{
  "manifest_version": 3,
  "name": "Manga → PDF",
  "version": "2.0",
  "description": "Выделяй страницы манги/манхвы/маньхуа и сохраняй в PDF",
  "browser_specific_settings": {
    "gecko": {
      "id": "manga-to-pdf@extension",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["activeTab", "downloads"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "128": "icons/icon.png" }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["jspdf.umd.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
